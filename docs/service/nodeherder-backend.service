[Unit]
Description=Node-Herder Backend Service
Wants=network-online.target
After=network-online.target

[Service]
User=mikeathan
WorkingDirectory=/home/mikeathan/dev/node-herder/backend
Environment=APP_ENV=production
ExecStart=/home/mikeathan/dev/node-herder/backend/nodeherder -port 9080
Restart=always
RestartSec=5

[Install]
WantedBy=nodeherder.target
