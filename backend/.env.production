APP_ENV=production
FRONTEND_BASE_URL=http://nodeherder.local
OAUTH_CALLBACK_URL=http://local.nodeherder.win/api/auth/callback
FRONTEND_ALLOWED_ORIGINS=http://local.nodeherder.win,http://nodeherder.local,http://localhost:4100,http://192.168.50.60:4001
OFFLINE_STRICT_LOCAL=true

# For local sign-in behind Docker Nginx, set its observed peer IP/CIDR in backend/.env.
# No proxy addresses are trusted by default. Replace with actual deployment values.
# TRUSTED_PROXY_CIDRS=
# For HTTPS termination only, enable Secure cookies in backend/.env:
# AUTH_COOKIE_SECURE=true
# For direct/local HTTP, leave both overrides unset (Secure-cookie default: false).
# Keep examples commented so they do not override backend/.env in Compose.
# Proxy identification and rollout: ../docs/runtime-reliability.md#nginx-trust-and-coordinated-upgrade
