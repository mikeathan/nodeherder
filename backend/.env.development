APP_ENV=development
FRONTEND_BASE_URL=http://192.168.50.251:4100
OAUTH_CALLBACK_URL=http://local.nodeherder.win/api/auth/callback
FRONTEND_ALLOWED_ORIGINS=http://local.nodeherder.win,http://localhost:4100,http://192.168.50.60:4001,http://192.168.50.251:4100
OFFLINE_STRICT_LOCAL=true

# Direct local HTTP needs no proxy trust or Secure-cookie override (defaults below).
# Leave these commented so backend/.env or process environment can override them.
# TRUSTED_PROXY_CIDRS=
# AUTH_COOKIE_SECURE=false
# If switching from HTTPS/proxy deployment, remove its overrides for direct HTTP.
# Local versus Nginx configuration: ../docs/setup.md#local-and-proxy-settings


