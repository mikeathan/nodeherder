{
  "name": "frontend",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test-server": "node ./tools/server/index.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest",
    "dev": "vite",
    "type-check": "vue-tsc --noEmit --watch",
    "type-check:e2e": "tsc --noEmit --project tsconfig.e2e.json",
    "build": "vue-tsc --noEmit --project tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "jest": {
    "globalSetup": "<rootDir>/jest.global-setup.cjs",
    "moduleFileExtensions": [
      "js",
      "ts",
      "json",
      "vue"
    ],
    "moduleNameMapper": {
      "^@/config/env$": "<rootDir>/src/__tests__/mocks/env.ts",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/__tests__/mocks/",
      "/src/__tests__/helpers/",
      "/e2e/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "types": ["vite/client", "jest", "node"]
        },
        "diagnostics": {
          "ignoreCodes": [
            1343
          ]
        }
      }
    }
  },
  "dependencies": {
    "@fontsource/figtree": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "@popperjs/core": "^2.11.8",
    "@primevue/themes": "^4.2.3",
    "@vue/babel-plugin-jsx": "^1.2.5",
    "chart.js": "4.5.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "eslint-plugin-import": "^2.31.0",
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "jwt-decode": "^4.0.0",
    "mitt": "^3.0.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.43",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.3",
    "serve": "^14.2.4",
    "timeago.js": "^4.0.2",
    "vue": "3.5.44",
    "vue-class-component": "^8.0.0-0",
    "vue-router": "4",
    "vuedraggable": "^4.1.0",
    "vuex": "^4.0.2",
    "vuex-persistedstate": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@mdi/js": "^7.4.47",
    "@playwright/test": "1.56.1",
    "@primevue/auto-import-resolver": "^4.2.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/vue": "^1.0.31",
    "@vitejs/plugin-vue": "^5.2.1",
    "cookie-parser": "^1.4.7",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^15.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.6",
    "vite-plugin-eslint": "^1.8.1",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.0.7"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended",
      "@vue/typescript"
    ],
    "parserOptions": {
      "parser": "@typescript-eslint/parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "overrides": {
    "serve": {
      "compression": "1.8.2"
    },
    "qs": "^6.16.0"
  }
}
