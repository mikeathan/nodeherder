{
  "compilerOptions": {
    "strict": true,
    "jsx": "preserve",
    "jsxFactory": "h",
    "experimentalDecorators": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "types": [
      "webpack-env"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "lib": [ // "lib": ["esnext", "dom", "dom.iterable", "scripthost"]
      "dom",
      "es5",
      "es2015"
    ],
    "target": "es5", // esnext
    "module": "es2015", // esnext
    "moduleResolution": "node",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.test.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "types": [
    "jest"
  ]
}